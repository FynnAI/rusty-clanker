// M3-B07 redstone parity corpus — content-plan entry #22 (PistonDoor).
// Built as a single representative column (smallest honest build) rather than a literal
// 2x2 block wall — the cited mechanism (sticky pull) is a single-piston property, not
// one that changes with door width.
ContraptionSpec(
    id: "redstone/piston/sticky_piston_retractor_door_2x2",
    category: PistonDoor,
    description: "A sticky piston starts already extended and powered, with its pushed block resting two cells out; removing the power retracts the head and pulls that block back to rest directly against the piston.",
    quirk: "Sticky-piston pull, canStickToEachOther (08-redstone-ticking.md §3.9, M3-B05 Context C) — the block sitting immediately beyond the retracting head is carried back with it.",
    max_ticks: 10,
    blocks: [
        (pos: (0, 1, 0), vanilla_state: "minecraft:sticky_piston[facing=east,extended=true]", state_id: 2236),
        (pos: (2, 1, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (-1, 1, 0), vanilla_state: "minecraft:redstone_block", state_id: 11311),
    ],
    actions: [
        (tick: 3, pos: (-1, 1, 0), vanilla_state: "minecraft:air", state_id: 0),
    ],
)
