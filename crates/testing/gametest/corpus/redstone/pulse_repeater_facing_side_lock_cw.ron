// M3-B07 redstone parity corpus — content-plan entry #50 (PulseGenerator).
ContraptionSpec(
    id: "redstone/pulse/pulse_repeater_facing_side_lock_cw",
    category: PulseGenerator,
    description: "A north-facing repeater whose clockwise (east) side is held locked by a permanently-powered repeater, while its own front input is independently toggled.",
    quirk: "alternate_signal reads max(control_input_signal(clockwise_neighbor), control_input_signal(counter_clockwise_neighbor)) — this entry isolates the clockwise term specifically (east, for a north-facing repeater), the mirror of entry #49's counter-clockwise case; both directions get an independent entry since the rotation is not symmetric in a facing-dependent build (M3-B04 Context §F; content-plan entry #50).",
    max_ticks: 10,
    blocks: [
        (pos: (0, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 1, 0), vanilla_state: "minecraft:repeater[facing=north,delay=1,locked=false,powered=false]", state_id: 7037),
        (pos: (0, 0, -1), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (1, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (1, 1, 0), vanilla_state: "minecraft:repeater[facing=east,delay=1,locked=false,powered=true]", state_id: 7048),
        (pos: (2, 1, 0), vanilla_state: "minecraft:redstone_block", state_id: 11311),
    ],
    actions: [
        (tick: 3, pos: (0, 1, -2), vanilla_state: "minecraft:redstone_block", state_id: 11311),
    ],
)
