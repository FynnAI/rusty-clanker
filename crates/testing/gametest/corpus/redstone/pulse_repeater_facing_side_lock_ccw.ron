// M3-B07 redstone parity corpus — content-plan entry #49 (PulseGenerator).
// `state_id` values below are placeholders (Implementation step 4) — see
// torch_inverter_basic.ron's own header comment.
ContraptionSpec(
    id: "redstone/pulse/pulse_repeater_facing_side_lock_ccw",
    category: PulseGenerator,
    description: "A north-facing repeater whose counter-clockwise (west) side is held locked by a permanently-powered repeater, while its own front input is independently toggled.",
    quirk: "alternate_signal reads max(control_input_signal(clockwise_neighbor), control_input_signal(counter_clockwise_neighbor)) — this entry isolates the counter-clockwise term specifically (west, for a north-facing repeater), since a max() of both sides could mask a bug in either individual read (M3-B04 Context §F; content-plan entry #49).",
    max_ticks: 10,
    blocks: [
        (pos: (0, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 1, 0), vanilla_state: "minecraft:repeater[facing=north,delay=1,locked=false,powered=false]", state_id: 220),
        (pos: (0, 0, -1), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (-1, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (-1, 1, 0), vanilla_state: "minecraft:repeater[facing=west,delay=1,locked=false,powered=true]", state_id: 221),
        (pos: (-2, 1, 0), vanilla_state: "minecraft:redstone_block", state_id: 101),
    ],
    actions: [
        (tick: 3, pos: (0, 1, -2), vanilla_state: "minecraft:redstone_block", state_id: 101),
    ],
)
