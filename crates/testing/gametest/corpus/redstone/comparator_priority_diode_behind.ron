// M3-B07 redstone parity corpus — content-plan entry #36 (ComparatorCircuit).
ContraptionSpec(
    id: "redstone/comparator/comparator_priority_diode_behind",
    category: ComparatorCircuit,
    description: "A comparator with a same-facing repeater directly behind it (in its own output direction, forming an ordinary daisy chain), triggered by a redstone_block at its input face.",
    quirk: "shouldPrioritize's EXTREMELY_HIGH scheduling — comparator shares repeater's own DiodeBlock-base priority selection (M3-B04 Context F/G), and a diode directly behind (here, a same-facing repeater) is prioritized (08-redstone-ticking.md §3.6).",
    max_ticks: 10,
    blocks: [
        (pos: (0, 1, 0), vanilla_state: "minecraft:comparator[facing=north,mode=compare,powered=false]", state_id: 11264, has_analog_state: true),
        // Field-report fix: repeater self-validates its own floor support immediately
        // on /setblock placement (unlike comparator, which doesn't) — this floor tile
        // must precede the repeater in list order, or the repeater never actually
        // comes into existence (placement silently reverts to air).
        (pos: (0, 0, 1), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 1, 1), vanilla_state: "minecraft:repeater[facing=north,delay=1,locked=false,powered=false]", state_id: 7037),
    ],
    actions: [
        (tick: 2, pos: (0, 1, -1), vanilla_state: "minecraft:redstone_block", state_id: 11311),
    ],
)
