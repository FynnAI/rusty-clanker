// M3-B07 redstone parity corpus — content-plan entry #30 (ComparatorCircuit).
ContraptionSpec(
    id: "redstone/comparator/comparator_compare_vs_subtract",
    category: ComparatorCircuit,
    description: "A comparator fed a fixed main input directly and a weaker side input via a two-hop wire tap off the same source, with its own mode swapped from compare to subtract mid-run against the unchanged input pair.",
    quirk: "calculateOutputSignal's two-mode formula, both branches evaluated against the identical (main, side) input pair — compare passes main through unchanged, subtract yields main minus side (08-redstone-ticking.md §3.6).",
    max_ticks: 12,
    blocks: [
        (pos: (0, 1, 0), vanilla_state: "minecraft:comparator[facing=north,mode=compare,powered=false]", state_id: 11264, has_analog_state: true),
        (pos: (0, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 1, -1), vanilla_state: "minecraft:redstone_torch[lit=true]", state_id: 6885),
        // M3.5-B03 governance fix: this torch's own floor cell was missing — every
        // other cell in this fixture already has its own floor row (below), but the
        // torch at z=-1 did not, so it popped to air on the first neighbor-changed
        // check.
        (pos: (0, 0, -1), vanilla_state: "minecraft:stone", state_id: 1),
        // Floor tiles precede their wire tiles here purely for build-order realism,
        // not because placement order is load-bearing: neither `WireBehavior` nor
        // `ComparatorBehavior::on_placed` validates floor support at `/setblock` time
        // (`WireBehavior::on_placed` only re-fires the diagonal-relay cascade off the
        // connection digits its own declared id already encodes; comparator's own
        // `on_placed` decodes facing/mode only) — the real support check for both runs
        // later, via `on_neighbor_changed`/`on_shape_update`, once every position in
        // this fixture's own `blocks:` list already exists regardless of order.
        (pos: (-1, 0, -1), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (-1, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (-1, 1, -1), vanilla_state: "minecraft:redstone_wire[power=0]", state_id: 4873),
        (pos: (-1, 1, 0), vanilla_state: "minecraft:redstone_wire[power=0]", state_id: 4721),
    ],
    actions: [
        (tick: 6, pos: (0, 1, 0), vanilla_state: "minecraft:comparator[facing=north,mode=subtract,powered=false]", state_id: 11266),
    ],
)
