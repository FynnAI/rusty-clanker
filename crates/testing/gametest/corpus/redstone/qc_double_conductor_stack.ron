    category: QcShowcase,
    description: "An east-facing piston with two plain conductors stacked directly above it; only the nearer of the two is ever side-powered.",
    quirk: "Piston quasi-connectivity examines only the 4 horizontal faces of the block directly above the piston, never a second conductor stacked one further away (08-redstone-ticking.md §3.9; M3-B05 Context §A step 3; content-plan entry #42) — plain conductor-to-conductor adjacency does not itself cascade power, so the piston must never extend.",
    max_ticks: 8,
    blocks: [
        (pos: (0, 0, 0), vanilla_state: "minecraft:piston[facing=east,extended=false]", state_id: 210),
        (pos: (0, 1, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 2, 0), vanilla_state: "minecraft:stone", state_id: 1),
    ],
    actions: [
        (tick: 3, pos: (1, 2, 0), vanilla_state: "minecraft:redstone_block", state_id: 101),
    ],
)
