ContraptionSpec(
    id: "redstone/update_order/update_order_mc11193_style_staleness",
    category: UpdateOrderProbe,
    description: "A straight 3-segment wire chain triggered at one end by an adjacent redstone block, observed tick by tick as the power level propagates down the chain.",
    quirk: "A wire's own recomputation reads possibly-stale neighbor power values mid-propagation; a chain converges to its final power level only after enough neighbor-changed passes have propagated the change along it, exactly the MC-11193-style staleness case MECH-D7/D11 name and preserve rather than correct (M3-B04 Context §F, restated by its own wire_chain_converges_over_multiple_neighbor_changed_passes acceptance test; content-plan entry #48).",
    max_ticks: 10,
    blocks: [
        (pos: (0, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (0, 1, 0), vanilla_state: "minecraft:redstone_wire[power=0]", state_id: 111),
        (pos: (1, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (1, 1, 0), vanilla_state: "minecraft:redstone_wire[power=0]", state_id: 111),
        (pos: (2, 0, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (2, 1, 0), vanilla_state: "minecraft:redstone_wire[power=0]", state_id: 111),
    ],
    actions: [
        (tick: 3, pos: (-1, 1, 0), vanilla_state: "minecraft:redstone_block", state_id: 101),
    ],
)
