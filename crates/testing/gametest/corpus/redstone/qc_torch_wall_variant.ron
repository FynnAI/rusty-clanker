ContraptionSpec(
    id: "redstone/qc/qc_torch_wall_variant",
    category: QcShowcase,
    description: "A wall-mounted redstone torch attached to a conductor's east face, with a redstone block later placed against a different face of that same conductor.",
    quirk: "RedstoneWallTorchBlock's own hasNeighborSignal check reads its attached conductor's general powered state, not a per-face value — powering the conductor from an unrelated face still inverts the torch, the horizontal-attachment variant of entry #37's floor-torch case (08-redstone-ticking.md §3.7; content-plan entry #53).",
    max_ticks: 8,
    blocks: [
        (pos: (0, 1, 0), vanilla_state: "minecraft:stone", state_id: 1),
        (pos: (1, 1, 0), vanilla_state: "minecraft:redstone_wall_torch[facing=east,lit=true]", state_id: 250),
    ],
    actions: [
        (tick: 3, pos: (0, 1, 1), vanilla_state: "minecraft:redstone_block", state_id: 101),
    ],
)
